# ============================================================
# Terraform
# ============================================================

# Local .terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable files
# These may contain passwords, private keys, and other secrets.
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform state lock information
.terraform.tfstate.lock.info

# Terraform plan files
*tfplan*
*.tfplan

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Terraform graph output
*.dot


